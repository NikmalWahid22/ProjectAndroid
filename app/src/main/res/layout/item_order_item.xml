<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Food Image -->
    <ImageView
        android:id="@+id/img_item"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_item_food"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Item Name -->
    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/inter_semibold"
        android:textSize="14sp"
        android:textColor="#002112"
        app:layout_constraintTop_toTopOf="@id/img_item"
        app:layout_constraintStart_toEndOf="@id/img_item"
        app:layout_constraintEnd_toStartOf="@id/tv_qty" />

    <!-- Item Price -->
    <TextView
        android:id="@+id/tv_item_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="#125B49"
        app:layout_constraintTop_toBottomOf="@id/tv_item_name"
        app:layout_constraintStart_toEndOf="@id/img_item"
        app:layout_constraintEnd_toStartOf="@id/tv_qty" />

    <TextView
        android:id="@+id/tv_customize_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="#40554A"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_item_price"
        app:layout_constraintStart_toEndOf="@id/img_item"
        app:layout_constraintEnd_toStartOf="@id/tv_qty" />

    <TextView
        android:id="@+id/tv_item_notes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="#7A5A00"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_customize_options"
        app:layout_constraintStart_toEndOf="@id/img_item"
        app:layout_constraintEnd_toStartOf="@id/tv_qty" />

    <!-- Qty -->
    <TextView
        android:id="@+id/tv_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:textSize="14sp"
        android:textColor="#002112"
        app:layout_constraintTop_toTopOf="@id/img_item"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/tv_item_notes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>