<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF8F2"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".SignInActivity">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:fontFamily="@font/inter_bold"
        android:textColor="#006C46"
        android:textSize="32sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi! Welcome Back, you've been missed"
        android:fontFamily="@font/inter_regular"
        android:textColor="#555555"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <!-- White Card Form -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- Hint text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please enter your detail sign in"
                android:fontFamily="@font/inter_regular"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Email Field -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#006C46"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:hint="Email"
                    android:fontFamily="@font/inter_regular"
                    android:textColorHint="#A8D5BF"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext" />
            </androidx.cardview.widget.CardView>

            <!-- Password Field -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#006C46"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <EditText
                        android:id="@+id/input_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Password"
                        android:fontFamily="@font/inter_regular"
                        android:textColorHint="#A8D5BF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="56dp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone" />

                    <TextView
                        android:id="@+id/tv_toggle_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:text="👁️"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/text_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Lupa password anda?"
                android:fontFamily="@font/inter_regular"
                android:textColor="#006C46"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Sign In Button -->
            <Button
                android:id="@+id/button_sign_in"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign In"
                android:fontFamily="@font/inter_semibold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#006C46"
                app:cornerRadius="14dp"
                android:layout_marginBottom="16dp" />

            <!-- DIVIDER OR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8E8E8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  atau  "
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8E8E8" />

            </LinearLayout>

            <!-- Google Sign In Button -->
            <Button
                android:id="@+id/btn_google_sign_in"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="  Masuk dengan Google"
                android:fontFamily="@font/inter_semibold"
                android:textSize="14sp"
                android:textColor="#444444"
                android:backgroundTint="#F5F5F5"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="8dp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Sign Up Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_signup_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Up"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="#006C46"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>