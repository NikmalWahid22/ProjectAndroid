<?xml version="1.0" encoding="utf-8"?>
    <androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <!-- Ganti ImageView img_menu dengan ini -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_menu"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/img_placeholder"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_menu_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/category_food"
                android:textSize="11sp"
                android:textColor="#125B49"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/img_menu"
                app:layout_constraintStart_toEndOf="@id/img_menu"
                app:layout_constraintEnd_toStartOf="@id/btn_edit"/>

            <TextView
                android:id="@+id/tv_menu_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Mie Ayam"
                android:textSize="15sp"
                android:textColor="#002112"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_menu_category"
                app:layout_constraintStart_toEndOf="@id/img_menu"
                app:layout_constraintEnd_toStartOf="@id/btn_edit"/>

            <TextView
                android:id="@+id/tv_menu_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Rp 15.000"
                android:textSize="13sp"
                android:textColor="#125B49"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_menu_name"
                app:layout_constraintStart_toEndOf="@id/img_menu"
                app:layout_constraintEnd_toStartOf="@id/btn_edit"/>

            <TextView
                android:id="@+id/tv_stock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Stock : 10"
                android:textSize="12sp"
                android:textColor="#D32F2F"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_menu_price"
                app:layout_constraintStart_toEndOf="@id/img_menu"
                app:layout_constraintEnd_toStartOf="@id/btn_edit"/>

            <ImageView
                android:id="@+id/btn_edit"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:src="@drawable/edit_icon"
                android:background="@drawable/bg_btn_edit"
                android:padding="8dp"
                app:tint="@android:color/white"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toTopOf="@id/img_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btn_delete"/>

            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:src="@drawable/delete_icon"
                android:background="@drawable/bg_btn_delete"
                android:padding="8dp"
                app:tint="@android:color/white"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="@id/img_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_edit"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>