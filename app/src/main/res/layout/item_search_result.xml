<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:padding="12dp"
    android:background="@android:color/white">

    <!-- FOOD IMAGE -->
    <ImageView
        android:id="@+id/item_food_image"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:src="@drawable/example_food"
        android:background="@drawable/rounded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- FOOD NAME -->
    <TextView
        android:id="@+id/item_food_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Burger Beef Deluxe"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/item_food_image"
        app:layout_constraintTop_toTopOf="@id/item_food_image"
        android:layout_marginStart="12dp"/>

    <!-- FOOD DESCRIPTION -->
    <TextView
        android:id="@+id/item_food_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Beef, cheese, onion, fresh veggies"
        android:fontFamily="@font/poppins_regular"
        android:textSize="13sp"
        android:textColor="@android:color/darker_gray"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/item_food_name"
        app:layout_constraintTop_toBottomOf="@id/item_food_name"/>

    <!-- PRICE -->
    <TextView
        android:id="@+id/item_food_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 25.000"
        android:fontFamily="@font/poppins_medium"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#438d5c"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@id/item_food_name"
        app:layout_constraintTop_toBottomOf="@id/item_food_desc"/>

</androidx.constraintlayout.widget.ConstraintLayout>
