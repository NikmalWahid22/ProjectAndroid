<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- GAMBAR -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_item"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img_placeholder"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- NAMA -->
        <TextView
            android:id="@+id/text_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mie Ayam"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:textColor="#002112"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/image_item"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toStartOf="@id/text_item_price" />

        <!-- CUSTOMIZE OPTIONS -->
        <TextView
            android:id="@+id/text_customize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Level Pedas: Sedang"
            android:fontFamily="@font/inter_regular"
            android:textSize="11sp"
            android:textColor="#125B49"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/text_item_name"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toStartOf="@id/text_item_price" />

        <!-- NOTES -->
        <TextView
            android:id="@+id/text_notes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="📝 Catatan"
            android:fontFamily="@font/inter_regular"
            android:textSize="11sp"
            android:textColor="#6B6B6B"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/text_customize"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toStartOf="@id/text_item_price" />

        <!-- QUANTITY -->
        <TextView
            android:id="@+id/text_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x1"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#006C46"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/text_notes"
            app:layout_constraintStart_toEndOf="@id/image_item" />

        <!-- HARGA -->
        <TextView
            android:id="@+id/text_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 15.000"
            android:fontFamily="@font/inter_bold"
            android:textSize="14sp"
            android:textColor="#006C46"
            app:layout_constraintTop_toTopOf="@id/image_item"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- HAPUS -->
        <TextView
            android:id="@+id/text_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus"
            android:fontFamily="@font/inter_semibold"
            android:textSize="12sp"
            android:textColor="#E53935"
            app:layout_constraintBottom_toBottomOf="@id/image_item"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>