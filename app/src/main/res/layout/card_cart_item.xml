<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#438d5c">

        <ImageView
            android:id="@+id/image_item"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/food_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="@string/content_description_item_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/text_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cart_item_name_placeholder"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toStartOf="@id/layout_quantity"/>

        <TextView
            android:id="@+id/text_item_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cart_item_details_placeholder"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/text_item_name"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toStartOf="@id/layout_quantity"/>

        <TextView
            android:id="@+id/text_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cart_item_price_placeholder"
            android:textColor="#FBBF00"
            android:fontFamily="@font/poppins_regular"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/text_item_details"
            app:layout_constraintStart_toEndOf="@id/image_item"/>

        <LinearLayout
            android:id="@+id/layout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btn_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_minus"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/text_quantity"
                android:fontFamily="@font/poppins_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cart_item_qty_placeholder"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/button_plus"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/text_remove"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:layout_height="wrap_content"
                android:text="@string/cart_item_remove_button"
                android:textColor="#FFBF00"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/edit_text_notes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/cart_item_notes_hint"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/white"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/white"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/image_item"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>