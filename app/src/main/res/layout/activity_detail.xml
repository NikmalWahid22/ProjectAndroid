<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".DetailActivity">

    <!-- GAMBAR BESAR DI ATAS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_image"
        android:layout_width="0dp"
        android:layout_height="330dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gradient dihapus, cukup image langsung -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_food_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_placeholder"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <!-- TOMBOL BACK -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/arrow_back"
        android:padding="10dp"
        android:background="@drawable/bg_button_white"
        app:tint="#002112"
        android:elevation="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TOMBOL LOVE/WISHLIST -->
    <ImageView
        android:id="@+id/btn_wishlist"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_heart"
        android:padding="10dp"
        android:background="@drawable/bg_button_white"
        app:tint="#E53935"
        android:elevation="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="@id/card_image"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="300dp"
            android:background="@drawable/bg_detail_sheet"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="28dp">

            <!-- NAMA MENU -->
            <TextView
                android:id="@+id/tv_food_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Hamburger"
                android:fontFamily="@font/inter_bold"
                android:textSize="22sp"
                android:textColor="#002112"
                android:includeFontPadding="false"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_food_price" />

            <!-- HARGA -->
            <TextView
                android:id="@+id/tv_food_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 25.000"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:textColor="#006C46"
                android:background="@drawable/bg_price_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:layout_constraintTop_toTopOf="@id/tv_food_name"
                app:layout_constraintBottom_toBottomOf="@id/tv_food_name"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- RATING -->
            <LinearLayout
                android:id="@+id/layout_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_detail_rating"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_food_name"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tv_rating_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐⭐⭐⭐⭐"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="13sp"
                    android:textColor="#002112"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tv_rating_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(500 Reviews)"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"
                    android:textColor="#5D6F66"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- DESKRIPSI -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Deskripsi makanan"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp"
                android:textColor="#40554A"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/layout_rating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- CUSTOMIZE ORDER TITLE -->
            <TextView
                android:id="@+id/tv_customize_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customize Your Order"
                android:fontFamily="@font/inter_bold"
                android:textSize="16sp"
                android:textColor="#002112"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tv_description"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CONTAINER CUSTOMIZE OPTIONS -->
            <LinearLayout
                android:id="@+id/layout_customize_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_customize_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- NOTES LABEL -->
            <TextView
                android:id="@+id/tv_notes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catatan Order"
                android:fontFamily="@font/inter_semibold"
                android:textSize="15sp"
                android:textColor="#002112"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/layout_customize_container"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- NOTES FIELD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDF5E8"
                app:layout_constraintTop_toBottomOf="@id/tv_notes_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/et_notes"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:hint="Tulis catatan di sini (opsional)"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="13sp"
                    android:textColor="#002112"
                    android:textColorHint="#A8B8AF"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine"
                    android:gravity="top" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM BUTTON -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_bottom_detail"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_minus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_minus"
            android:padding="10dp"
            android:background="@drawable/bg_btn_replace"
            app:tint="#006C46"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_quantity"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:fontFamily="@font/inter_bold"
            android:textSize="17sp"
            android:textColor="#002112"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btn_plus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_add"
            android:padding="10dp"
            android:background="@drawable/bg_button_primary"
            app:tint="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_to_cart"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Add To Cart"
            android:fontFamily="@font/inter_semibold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>