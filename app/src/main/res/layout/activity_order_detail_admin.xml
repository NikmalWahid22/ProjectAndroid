<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".OrderDetailAdminActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/back_to"
                android:padding="2dp"
                app:tint="#002112"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_order_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/order_detail_title"
                android:fontFamily="@font/inter_bold"
                android:textSize="22sp"
                android:textColor="#002112"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/btn_back"
                app:layout_constraintBottom_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/layout_placed_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_order_title"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/clock"
                    app:tint="#6B6B6B"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_placed_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_placed_on"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"
                    android:textColor="#6B6B6B" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_status_process"
                android:fontFamily="@font/inter_semibold"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_process"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/layout_placed_on"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_order_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_order_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_order_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:padding="16dp"
                    tools:listitem="@layout/item_order_item" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_customer_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/card_order_items"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ic_customer"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/profile_admin"
                        app:tint="#006C46"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_customer_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customer_detail"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="15sp"
                        android:textColor="#002112"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="@id/ic_customer"
                        app:layout_constraintBottom_toBottomOf="@id/ic_customer"
                        app:layout_constraintStart_toEndOf="@id/ic_customer" />

                    <TextView
                        android:id="@+id/label_nama"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nama"
                        android:textSize="11sp"
                        android:textColor="#125B49"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_customer_detail_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/label_contact" />

                    <TextView
                        android:id="@+id/label_contact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_contact"
                        android:textSize="11sp"
                        android:textColor="#125B49"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_customer_detail_title"
                        app:layout_constraintStart_toEndOf="@id/label_nama"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_customer_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nikmal Wahid"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#002112"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/label_nama"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_customer_contact" />

                    <TextView
                        android:id="@+id/tv_customer_contact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="0897654321"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#002112"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/label_contact"
                        app:layout_constraintStart_toEndOf="@id/tv_customer_name"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/label_payment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_payment_method"
                        android:textSize="11sp"
                        android:textColor="#125B49"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_customer_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/label_pickup" />

                    <TextView
                        android:id="@+id/label_pickup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_pickup_method"
                        android:textSize="11sp"
                        android:textColor="#125B49"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_customer_contact"
                        app:layout_constraintStart_toEndOf="@id/label_payment"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_payment_method"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#002112"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/label_payment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_pickup_method" />

                    <TextView
                        android:id="@+id/tv_pickup_method"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Delivery Order"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#002112"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/label_pickup"
                        app:layout_constraintStart_toEndOf="@id/tv_payment_method"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_update_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/card_customer_detail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_update_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_status"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="16sp"
                        android:textColor="#002112" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_status_pending"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DDF5E8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="top"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/tunda"
                                    app:tint="#006C46" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pending"
                                    android:fontFamily="@font/inter_semibold"
                                    android:textSize="12sp"
                                    android:textColor="#002112"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Menunggu"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#006C46"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_status_process"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DDF5E8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="top"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/process"
                                    app:tint="#006C46" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Process"
                                    android:fontFamily="@font/inter_semibold"
                                    android:textSize="12sp"
                                    android:textColor="#002112"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dimasak"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#006C46"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_status_ready"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DDF5E8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="top"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ready"
                                    app:tint="#006C46" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready"
                                    android:fontFamily="@font/inter_semibold"
                                    android:textSize="12sp"
                                    android:textColor="#002112"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Siap diambil"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#006C46"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_status_success"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DDF5E8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="top"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/success"
                                    app:tint="#006C46" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Success"
                                    android:fontFamily="@font/inter_semibold"
                                    android:textSize="12sp"
                                    android:textColor="#002112"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Selesai"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#006C46"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="#EEF8F2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_changes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_save_changes"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_cancel"
            android:textColor="#002112"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>