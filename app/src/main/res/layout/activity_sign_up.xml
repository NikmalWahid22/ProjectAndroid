<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- GUIDELINE TOP (18% layar) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.18" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/text_title_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#438d5c"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/guide_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/text_subtitle_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Fill your information below or register with your social account"
            android:textColor="#000000"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/text_title_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- NAME -->
        <EditText
            android:id="@+id/input_name_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#438d5c"
            android:textColor="#000000"
            android:textColorHint="#777777"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/text_subtitle_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/input_email_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#438d5c"
            android:textColor="#000000"
            android:textColorHint="#777777"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/input_name_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/input_password_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#438d5c"
            android:textColor="#000000"
            android:textColorHint="#777777"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/input_email_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TERMS + CHECKBOX -->
        <LinearLayout
            android:id="@+id/layout_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/input_password_register"
            app:layout_constraintStart_toStartOf="parent">

            <CheckBox
                android:id="@+id/checkbox_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I Agree With"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/text_terms_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Terms &amp; Conditions"
                android:textColor="#438d5c"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- SIGN UP BUTTON -->
        <Button
            android:id="@+id/button_sign_up_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textSize="18sp"
            android:backgroundTint="#438d5c"
            android:textColor="#FFFFFF"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/layout_terms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- SOCIAL TEXT SEPARATOR -->


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
