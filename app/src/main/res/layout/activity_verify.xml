<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".VerifyCodeActivity">

    <TextView
        android:id="@+id/text_title_verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Code"
        android:textColor="#4CAF50"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_verify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.40" />

    <TextView
    android:id="@+id/text_subtitle_verify"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Please enter the code we just sent to email example@gmail.com"
    android:textColor="@android:color/black"
    android:textSize="14sp"
    android:gravity="center"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/text_title_verify"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_otp_fields"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/text_subtitle_verify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#66BB6A"
            android:layout_marginEnd="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#66BB6A"
            android:layout_marginEnd="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#66BB6A"
            android:layout_marginEnd="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#66BB6A"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_didnt_receive_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Didn't receive OTP?"
        android:textSize="14sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layout_otp_fields"
        app:layout_constraintEnd_toStartOf="@id/text_resend_link"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_resend_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend Email"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@id/text_didnt_receive_otp"
        app:layout_constraintTop_toTopOf="@id/text_didnt_receive_otp"
        app:layout_constraintStart_toEndOf="@id/text_didnt_receive_otp"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button_verify"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verify"
        android:textSize="18sp"
        android:backgroundTint="#559955"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginTop="32dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/text_resend_link"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>