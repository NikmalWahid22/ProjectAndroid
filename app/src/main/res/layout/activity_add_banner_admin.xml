<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".AddBannerAdminActivity">

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_add_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Banner"
                android:fontFamily="@font/inter_bold"
                android:textSize="22sp"
                android:textColor="#002112"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_add_banner_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- LABEL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner Image"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="14sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="10dp" />

                    <!-- PREVIEW -->
                    <FrameLayout
                        android:id="@+id/frame_photo"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:background="@drawable/bg_photo_preview"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_banner_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:src="@drawable/photo"
                                app:tint="#006C46"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to upload banner"
                                android:textColor="#006C46"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/inter_semibold"/>
                        </LinearLayout>

                    </FrameLayout>

                    <!-- TIPS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommended size 1200x500px • PNG/JPG"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter_regular"/>

                    <!-- BUTTONS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- REPLACE -->
                        <LinearLayout
                            android:id="@+id/btn_replace_photo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_btn_replace"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/process"
                                app:tint="#006C46"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Replace"
                                android:textColor="#006C46"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_semibold"/>
                        </LinearLayout>

                        <!-- DELETE -->
                        <LinearLayout
                            android:id="@+id/btn_delete_photo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_btn_delete"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/delete_icon"
                                app:tint="@android:color/white"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delete"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_semibold"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"/>

                    <!-- TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner Title"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_banner_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:inputType="text"
                        android:maxLines="1"
                        android:layout_marginBottom="12dp"/>

                    <!-- DESCRIPTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner Description"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_banner_description"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_field_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginBottom="12dp"/>

                    <!-- TAG -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner Tag"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_banner_tag"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:hint="Promo / Hot / New"
                        android:maxLines="1"/>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"/>

                    <!-- POSITION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner Position"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_banner_position"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:hint="1"
                        android:inputType="number"
                        android:maxLines="1"
                        android:layout_marginBottom="16dp"/>

                    <!-- ACTIVE SECTION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F5FFF9"
                        android:padding="14dp"
                        android:backgroundTint="#F5FFF9">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Banner"
                                android:textColor="#002112"
                                android:textSize="14sp"
                                android:fontFamily="@font/inter_semibold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Banner akan tampil di Home User"
                                android:textColor="#7A7A7A"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"/>

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_active_banner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="#B9F5D7"
                            app:thumbTint="#006C46"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM BUTTON -->
    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="#EEF8F2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_banner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Banner"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:background="@drawable/bg_button_primary"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#002112"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:background="@android:color/transparent"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>