<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".OrderTrackingActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- BACK BUTTON -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/arrow_back"
                android:padding="9dp"
                android:background="@drawable/bg_button_white"
                android:elevation="2dp"
                app:tint="#002112"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Tracking"
                android:fontFamily="@font/inter_bold"
                android:textSize="22sp"
                android:textColor="#002112"
                app:layout_constraintTop_toTopOf="@id/btn_back"
                app:layout_constraintBottom_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- TOP INFO ROW -->
            <LinearLayout
                android:id="@+id/layout_tracking_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- QUEUE NUMBER CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_queue"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Queue Number"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="12sp"
                            android:textColor="#7A9E8E" />

                        <TextView
                            android:id="@+id/tv_queue_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#CE-12345"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="19sp"
                            android:textColor="#006C46"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ESTIMATED TIME CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_estimated"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#E8FFF4"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="12sp"
                            android:textColor="#7A9E8E" />

                        <TextView
                            android:id="@+id/tv_estimated_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 mins"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="22sp"
                            android:textColor="#006C46"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- STATUS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#006C46"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layout_tracking_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparing Your Meal"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tv_status_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Our kitchen staff is carefully assembling your CampEats Box with fresh seasonal ingredients."
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp"
                        android:textColor="#A8FFE0"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ORDER JOURNEY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_journey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Journey"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="15sp"
                        android:textColor="#002112"
                        android:layout_marginBottom="16dp" />

                    <!-- STEP 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ic_step1"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_step_done"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Order Confirmed"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="13sp"
                                android:textColor="#002112" />

                            <TextView
                                android:id="@+id/tv_step1_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:40 PM · Success"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#7A9E8E"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="26dp"
                        android:background="#006C46"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                    <!-- STEP 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ic_step2"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_step_active"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Preparing"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="13sp"
                                android:textColor="#002112" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Phase"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#006C46"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="26dp"
                        android:background="#DDF5E8"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                    <!-- STEP 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ic_step3"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_step_inactive"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ready for Pickup"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="13sp"
                                android:textColor="#7A9E8E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Preparing in 15 mins"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#A8B8AF"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="26dp"
                        android:background="#DDF5E8"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                    <!-- STEP 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ic_step4"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_step_inactive"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Picked Up"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="13sp"
                                android:textColor="#7A9E8E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Final Step"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#A8B8AF"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ORDER SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_order_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_journey"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order Summary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"
                            android:textColor="#002112" />

                        <TextView
                            android:id="@+id/tv_your_point"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Receipt"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="12sp"
                            android:textColor="#006C46" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F7F4"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_order_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F7F4"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Price"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="14sp"
                            android:textColor="#002112" />

                        <TextView
                            android:id="@+id/tv_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="16sp"
                            android:textColor="#006C46" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION — nempel ke bawah, rounded pojok atas -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_navbar_rounded_top"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME - inactive -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/home_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- SEARCH - inactive -->
        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- CART - inactive -->
        <LinearLayout
            android:id="@+id/nav_cart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/cart_icon"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- PROFILE - active -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_nav_active">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/profile_admin"
                app:tint="#006C46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#006C46"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>