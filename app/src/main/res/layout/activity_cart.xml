<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".CartActivity">

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_content_cart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Cart"
                android:fontFamily="@font/inter_bold"
                android:textSize="26sp"
                android:textColor="#002112"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- TOMBOL RIWAYAT ORDER -->
            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#006C46"
                app:layout_constraintTop_toTopOf="@id/tv_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_title"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btn_order_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/order_admin"
                    android:padding="10dp"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />

            </androidx.cardview.widget.CardView>

            <!-- SUBTITLE -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Periksa pesanan kamu sebelum checkout"
                android:fontFamily="@font/inter_regular"
                android:textSize="12sp"
                android:textColor="#7A9E8E"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- EMPTY CART -->
            <LinearLayout
                android:id="@+id/layout_empty_cart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="80dp"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_empty_cart"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:lottie_rawRes="@raw/empty_cart"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keranjang Belanjamu Kosong"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="16sp"
                    android:textColor="#002112"
                    android:layout_marginTop="16dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_back_to_home"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Mulai Belanja"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <!-- RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_cart_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- DELIVERY OPTIONS TITLE -->
            <TextView
                android:id="@+id/tv_delivery_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Metode Pengiriman"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"
                android:textColor="#002112"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/recycler_cart_items"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- DELIVERY OPTIONS -->
            <LinearLayout
                android:id="@+id/layout_delivery_options"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tv_delivery_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ANTAR KE TEMPAT -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_delivery"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#006C46"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:gravity="top">

                        <ImageView
                            android:id="@+id/icon_delivery"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_delivery"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/text_delivery_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Antar ke Tempat"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/text_delivery_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+Rp 5.000"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="11sp"
                            android:textColor="#87FFD0"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- AMBIL SENDIRI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pickup"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DDF5E8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:gravity="top">

                        <ImageView
                            android:id="@+id/icon_pickup"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pickup"
                            app:tint="#006C46" />

                        <TextView
                            android:id="@+id/text_pickup_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ambil Sendiri"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="12sp"
                            android:textColor="#002112"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/text_pickup_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gratis"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="11sp"
                            android:textColor="#006C46"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- PRICE SUMMARY CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_price_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#9DFFD8"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/layout_delivery_options"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- SUBTOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"
                            android:textColor="#125B49" />

                        <TextView
                            android:id="@+id/tv_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="13sp"
                            android:textColor="#006C46" />

                    </LinearLayout>

                    <!-- ONGKIR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ongkir"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"
                            android:textColor="#125B49" />

                        <TextView
                            android:id="@+id/tv_shipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 5.000"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="13sp"
                            android:textColor="#006C46" />

                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#006C46"
                        android:alpha="0.2"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- TOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"
                            android:textColor="#002112" />

                        <TextView
                            android:id="@+id/tv_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"
                            android:textColor="#006C46" />

                    </LinearLayout>

                    <!-- TOMBOL CHECKOUT -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_checkout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Checkout Rp 0"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button_primary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_navbar_rounded_top"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME - inactive -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/home_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- SEARCH - inactive -->
        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- CART - active -->
        <LinearLayout
            android:id="@+id/nav_cart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_nav_active">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/cart_icon"
                app:tint="#006C46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textColor="#006C46"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- PROFILE - inactive -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/profile_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>