<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- FOOD IMAGE -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_food"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_placeholder"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- CATEGORY -->
        <TextView
            android:id="@+id/tv_food_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Makanan"
            android:fontFamily="@font/inter_semibold"
            android:textSize="10sp"
            android:textColor="#006C46"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="@id/img_food"
            app:layout_constraintStart_toEndOf="@id/img_food"
            app:layout_constraintEnd_toStartOf="@id/tv_rating" />

        <!-- FOOD NAME -->
        <TextView
            android:id="@+id/tv_food_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mie Ayam"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:textColor="#002112"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_food_category"
            app:layout_constraintStart_toEndOf="@id/img_food"
            app:layout_constraintEnd_toStartOf="@id/tv_rating" />

        <!-- PRICE -->
        <TextView
            android:id="@+id/tv_food_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 15.000"
            android:fontFamily="@font/inter_bold"
            android:textSize="14sp"
            android:textColor="#006C46"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@id/img_food"
            app:layout_constraintBottom_toBottomOf="@id/img_food" />

        <!-- RATING BADGE -->
        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 4.3"
            android:fontFamily="@font/inter_semibold"
            android:textSize="11sp"
            android:textColor="#002112"
            android:background="@drawable/bg_rating"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toTopOf="@id/img_food"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ADD BUTTON -->
        <androidx.cardview.widget.CardView
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#006C46"
            app:layout_constraintBottom_toBottomOf="@id/img_food"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btn_add_to_cart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add"
                android:padding="8dp"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>