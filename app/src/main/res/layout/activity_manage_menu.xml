<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".ManageMenuAdminActivity">

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_manage_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_menu"
                android:fontFamily="@font/inter_bold"
                android:textSize="22sp"
                android:textColor="#002112"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- SEARCH ICON -->
            <ImageView
                android:id="@+id/btn_search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/manage_icon"
                app:tint="#002112"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/tv_manage_menu_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_manage_menu_title"
                app:layout_constraintStart_toEndOf="@id/tv_manage_menu_title" />

            <!-- BUTTON TAMBAH MENU -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_tambah_menu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/btn_tambah_menu"
                android:fontFamily="@font/inter_semibold"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_manage_menu_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- SEARCH BAR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_search"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/btn_tambah_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@android:color/darker_gray"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_search_menu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/hint_cari_menu"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#002112"
                        android:textColorHint="@android:color/darker_gray"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- INFORMATION CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_information"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/card_search"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- TITLE -->
                    <TextView
                        android:id="@+id/tv_information_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/information"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="15sp"
                        android:textColor="#002112"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- TOTAL ITEM -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_total_item"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#87FFD0"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_information_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/card_categories">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_total_item_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="20sp"
                                android:textColor="#002112" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_item"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#125B49" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- CATEGORIES -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_categories"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="#87FFD0"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_information_title"
                        app:layout_constraintStart_toEndOf="@id/card_total_item"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_categories_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="20sp"
                                android:textColor="#002112" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/categories"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#125B49" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- LOW STOCK -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_low_stock"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#87FFD0"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/card_total_item"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/card_live_stock">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_low_stock_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="20sp"
                                android:textColor="#002112" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/low_stock"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#125B49" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- LIVE STOCK -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_live_stock"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="#87FFD0"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/card_categories"
                        app:layout_constraintStart_toEndOf="@id/card_low_stock"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_live_stock_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="20sp"
                                android:textColor="#002112" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/live_stock"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:textColor="#125B49" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- RECYCLERVIEW MENU -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_menu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_menu_admin"
                app:layout_constraintTop_toBottomOf="@id/card_information"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_navbar_rounded_top"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME - inactive -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/home_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- ORDERS - active -->
        <LinearLayout
            android:id="@+id/nav_orders"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_nav_active">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/order_admin"
                app:tint="#006C46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Orders"
                android:textColor="#006C46"
                android:textSize="10sp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- PROFILE - inactive -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/profile_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>