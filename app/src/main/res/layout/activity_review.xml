<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".ReviewActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/arrow_back"
                android:padding="10dp"
                android:background="@drawable/bg_button_white"
                app:tint="#002112"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Beri Rating"
                android:fontFamily="@font/inter_bold"
                android:textSize="24sp"
                android:textColor="#002112"
                android:gravity="center"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                app:layout_constraintTop_toTopOf="@id/btn_back"
                app:layout_constraintBottom_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_review_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp">
                    <TextView
                        android:id="@+id/tv_food_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Indomie Nyemek"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="19sp"
                        android:textColor="#002112"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_rating_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Bagaimana pengalamanmu dengan menu ini?"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#7A9E8E"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_food_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <LinearLayout
                        android:id="@+id/layout_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="18dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_rating_hint"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/star1"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_star_outline"
                            android:padding="2dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/star2"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_star_outline"
                            android:padding="2dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/star3"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_star_outline"
                            android:padding="2dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/star4"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_star_outline"
                            android:padding="2dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/star5"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_star_outline"
                            android:padding="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_rating_caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Tap bintang untuk memberi penilaian"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp"
                        android:textColor="#7A9E8E"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_stars"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_review_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ulasan"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="14sp"
                        android:textColor="#002112"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_rating_caption"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_review"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="#F8FFFB"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DDF5E8"
                        app:layout_constraintTop_toBottomOf="@id/tv_review_label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <EditText
                            android:id="@+id/et_review"
                            android:layout_width="match_parent"
                            android:layout_height="136dp"
                            android:hint="Tulis ulasanmu di sini..."
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"
                            android:textColor="#002112"
                            android:textColorHint="#A8B8AF"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:inputType="textMultiLine"
                            android:gravity="top" />
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Kirim Ulasan"
                android:fontFamily="@font/inter_semibold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_primary"
                app:layout_constraintTop_toBottomOf="@id/card_review_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>