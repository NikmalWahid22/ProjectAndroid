<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#DDF5E8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ORDER ID -->
        <TextView
            android:id="@+id/tv_order_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="#CE-12345"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:textColor="#002112"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_status" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:fontFamily="@font/inter_semibold"
            android:textSize="11sp"
            android:textColor="#006C46"
            android:background="@drawable/bg_tag_offer"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_order_id"
            app:layout_constraintBottom_toBottomOf="@id/tv_order_id"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- TANGGAL -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="20 Apr 2026 12:33"
            android:fontFamily="@font/inter_regular"
            android:textSize="12sp"
            android:textColor="#5D6F66"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/tv_order_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- DIVIDER -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDF5E8"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- PAYMENT LABEL -->
        <TextView
            android:id="@+id/tv_payment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="E-Wallet"
            android:fontFamily="@font/inter_regular"
            android:textSize="12sp"
            android:textColor="#5D6F66"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_total" />

        <!-- TOTAL -->
        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 35.000"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:textColor="#006C46"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/tv_payment"
            app:layout_constraintBottom_toBottomOf="@id/tv_payment"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- POINT -->
        <TextView
            android:id="@+id/tv_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+5 point"
            android:fontFamily="@font/inter_semibold"
            android:textSize="11sp"
            android:textColor="#006C46"
            android:background="@drawable/bg_receipt_total"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_payment"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- TOMBOL LIHAT DETAIL -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_detail"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:text="Lihat Detail"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#006C46"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_replace"
            app:layout_constraintTop_toBottomOf="@id/tv_point"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- TOMBOL BERI RATING — hanya muncul kalau Done -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_rating"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="⭐ Beri Rating"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#006C46"
            android:textAllCaps="false"
            android:background="@drawable/bg_chip_unselected"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btn_detail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>