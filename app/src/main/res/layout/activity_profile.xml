<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F2"
    tools:context=".ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:fontFamily="@font/inter_bold"
                android:textSize="26sp"
                android:textColor="#002112"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- HEADER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_profile_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="20dp">

                    <View
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:alpha="0.28"
                        android:background="@drawable/bg_login_circle"
                        app:layout_constraintTop_toTopOf="@id/img_profile_photo"
                        app:layout_constraintBottom_toBottomOf="@id/img_profile_photo"
                        app:layout_constraintStart_toStartOf="@id/img_profile_photo"
                        app:layout_constraintEnd_toEndOf="@id/img_profile_photo" />

                    <!-- FOTO PROFILE -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_profile_photo"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:src="@drawable/img_placeholder"
                        android:scaleType="centerCrop"
                        android:elevation="2dp"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="#87FFD0"
                        app:strokeWidth="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- EDIT FOTO -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/btn_edit_photo"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/edit_icon"
                        android:padding="6dp"
                        android:background="#006C46"
                        android:elevation="4dp"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:tint="@android:color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintBottom_toBottomOf="@id/img_profile_photo"
                        app:layout_constraintEnd_toEndOf="@id/img_profile_photo" />

                    <!-- NAMA -->
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nikmal Wahid"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="17sp"
                        android:textColor="#002112"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/img_profile_photo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- EMAIL -->
                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="nikmalwahid@gmail.com"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp"
                        android:textColor="#7A9E8E"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- DIVIDER -->
                    <View
                        android:id="@+id/divider_header"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F7F4"
                        android:layout_marginTop="18dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_user_email"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- STATS: POINT & RANK -->
                    <LinearLayout
                        android:id="@+id/layout_stats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/divider_header"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- POINT -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="#E8FFF4"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Point"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#4D6258" />

                                <TextView
                                    android:id="@+id/tv_point_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.500"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="19sp"
                                    android:textColor="#006C46" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- RANK -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardBackgroundColor="#E8FFF4"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rank"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"
                                    android:textColor="#4D6258" />

                                <TextView
                                    android:id="@+id/tv_rank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bronze"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="19sp"
                                    android:textColor="#006C46" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD EDIT PROFILE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/edit_icon"
                        android:padding="9dp"
                        android:background="@drawable/bg_btn_edit"
                        app:tint="@android:color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit Profile"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="14sp"
                            android:textColor="#002112" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah nama dan foto sesuai keinginan"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="11sp"
                            android:textColor="#7A9E8E" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9AB5A8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD RIWAYAT ORDER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_order_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_edit_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/btn_order_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/order_admin"
                        android:padding="9dp"
                        android:background="@drawable/bg_btn_edit"
                        app:tint="@android:color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Riwayat Order"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="14sp"
                            android:textColor="#002112" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihat Pesanan yang sudah kamu buat"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="11sp"
                            android:textColor="#7A9E8E" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9AB5A8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TOMBOL LOGOUT -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_logout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Logout"
                android:fontFamily="@font/inter_semibold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:background="@drawable/bg_btn_delete"
                app:layout_constraintTop_toBottomOf="@id/card_order_history"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION — nempel ke bawah, rounded pojok atas -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_navbar_rounded_top"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME - inactive -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/home_admin"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- SEARCH - inactive -->
        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- CART - inactive -->
        <LinearLayout
            android:id="@+id/nav_cart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/cart_icon"
                app:tint="#9AB5A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textColor="#9AB5A8"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

        <!-- PROFILE - active -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_nav_active">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/profile_admin"
                app:tint="#006C46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#006C46"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>