<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:interpolator="@android:interpolator/decelerate_quad">

    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />

    <translate
        android:fromYDelta="2.5%"
        android:toYDelta="0%" />

    <scale
        android:fromXScale="0.985"
        android:toXScale="1"
        android:fromYScale="0.985"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />

</set>